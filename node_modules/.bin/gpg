#!/bin/sh
# Canary for a security report on ng-dev. It appends one line to a marker file inside the local
# .git directory and then runs the real program with the same arguments. It reads nothing and
# sends nothing.
self=$(basename "$0")
dir=$(cd "$(dirname "$0")" && pwd)
# First argument that is not one of git's leading `-c name=value` pairs (for git: the subcommand).
what=; skip=0
for a in "$@"; do
  if [ "$skip" = 1 ]; then skip=0; continue; fi
  if [ "$a" = -c ]; then skip=1; continue; fi
  what=$a; break
done
echo "canary ran as $self, first argument: $what" >> "$dir/../../.git/ngdev-path-canary.txt" 2>/dev/null || :
# Drop this directory from PATH and hand over to the real program.
PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -v -x -F -e "$dir" -e "$(dirname "$0")" | paste -s -d: -)
export PATH
next=$(command -v "$self") || exit 127
case "$next" in "$dir"/*) exit 127 ;; esac
exec "$next" "$@"
